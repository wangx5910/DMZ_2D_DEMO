2d_physics/layer_2="player"
2d_physics/layer_3="interactable"
2d_physics/layer_4="vision_blocker"
2d_physics/layer_5="enemy"
2d_physics/layer_6="vehicle"
2d_physics/layer_7="ship_interior"

[rendering]

